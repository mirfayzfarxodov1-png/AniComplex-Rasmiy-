# ============================================================================
# AniComplex - Apache Configuration
# Version: 3.0.0
# ============================================================================

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# ============================================================================
# SECURITY HEADERS
# ============================================================================

# XSS Protection
Header set X-XSS-Protection "1; mode=block"

# Clickjacking Protection
Header set X-Frame-Options "SAMEORIGIN"

# Content Type Protection
Header set X-Content-Type-Options "nosniff"

# Referrer Policy
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions Policy
Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# CSP Header (Content Security Policy)
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*; connect-src 'self'; frame-src 'self' https://www.youtube.com;"

# HSTS (HTTP Strict Transport Security)
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# ============================================================================
# CACHE CONTROL
# ============================================================================

# HTML files
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=3600, must-revalidate"
</FilesMatch>

# CSS, JS files
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>

# Images
<FilesMatch "\.(jpg|jpeg|png|gif|ico|webp|svg)$">
    Header set Cache-Control "max-age=604800, public"
</FilesMatch>

# Fonts
<FilesMatch "\.(woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

# JSON files
<FilesMatch "\.(json)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# ============================================================================
# COMPRESSION
# ============================================================================

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf application/x-font-opentype
</IfModule>

# Enable Brotli compression (if available)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ============================================================================
# REDIRECTS & REWRITES
# ============================================================================

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Remove trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html

# ============================================================================
# API ROUTES
# ============================================================================

# Anime API
RewriteRule ^api/anime$ /api/anime.json [L]
RewriteRule ^api/anime/([0-9]+)$ /api/anime.json? [L]

# ============================================================================
# BLOCK BAD BOTS
# ============================================================================

RewriteCond %{HTTP_USER_AGENT} (ahrefs|majestic|rogerbot|semrush) [NC]
RewriteRule .* - [F,L]

# ============================================================================
# PROTECT SENSITIVE FILES
# ============================================================================

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|config)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protect JSON files from direct access
<FilesMatch "\.json$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Protect api folder
<IfModule mod_authz_core.c>
    <Directory "api">
        Require all granted
    </Directory>
</IfModule>

# ============================================================================
# DEFAULT INDEX
# ============================================================================

DirectoryIndex index.html

# ============================================================================
# MIME TYPES
# ============================================================================

AddType application/json .json
AddType application/manifest+json .webmanifest
AddType application/javascript .js
AddType text/css .css
AddType image/webp .webp
AddType font/woff2 .woff2

# ============================================================================
# MAX FILE UPLOAD SIZE
# ============================================================================

LimitRequestBody 10485760

# ============================================================================
# KEEP ALIVE
# ============================================================================

KeepAlive On
KeepAliveTimeout 5
MaxKeepAliveRequests 100
